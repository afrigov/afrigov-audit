{
  "name": "afrigov-audit",
  "version": "0.1.0",
  "description": "Audit any website for accessibility from the command line. Runs axe-core at phone and desktop widths, adds checks for the failures common on government sites, and tells you which afrigov component fixes each one.",
  "keywords": [
    "accessibility",
    "a11y",
    "audit",
    "axe-core",
    "wcag",
    "government",
    "africa",
    "cli",
    "afrigov"
  ],
  "license": "MIT",
  "author": "Abimbola Omoyola",
  "homepage": "https://github.com/omoyolab/afrigov-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omoyolab/afrigov-audit.git"
  },
  "bugs": {
    "url": "https://github.com/omoyolab/afrigov-audit/issues"
  },
  "type": "module",
  "bin": {
    "afrigov-audit": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm build && pnpm test",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "axe-core": "^4.10.3",
    "playwright": "^1.58.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
